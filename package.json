{
  "name": "xocrisk",
  "version": "0.1.0",
  "private": true,
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "^11.0.0",
      "onFail": "warn"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "start": "npm run start --workspace @xocrisk/api",
    "build:web": "node scripts/build-app.mjs && node scripts/copy-web-export.mjs",
    "web": "npm run build:web && serve www -l 5173",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "sync": "cap sync",
    "android": "cap sync android && cap open android",
    "ios": "cap sync ios && cap open ios"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "8.0.2",
    "@capacitor/android": "^6.2.1",
    "@capacitor/app": "6.0.3",
    "@capacitor/core": "^6.2.1",
    "@capacitor/ios": "^6.2.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1",
    "serve": "^14.2.4",
    "turbo": "^2.5.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "light-my-request": "6.6.0"
  }
}
