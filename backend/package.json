{
  "name": "@xocrisk/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "migrate": "tsx scripts/migrate.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test test/*.test.mjs",
    "update-instruments": "tsx scripts/update-instruments.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/formbody": "^8.0.2",
    "@fastify/rate-limit": "^10.2.1",
    "@xocrisk/core": "*",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "jose": "^6.0.11",
    "light-my-request": "6.6.0",
    "nodemailer": "^10.1.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@types/node": "^20.17.19",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.11",
    "tsx": "^4.19.3",
    "typescript": "^5.9.3"
  },
  "exports": {
    "./serverless": {
      "types": "./dist/serverless.d.ts",
      "import": "./dist/serverless.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "import": "./dist/http.js"
    }
  },
  "engines": {
    "node": "24.x"
  }
}
