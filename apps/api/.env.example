NODE_ENV=development
HOST=127.0.0.1
PORT=4000
WEB_ORIGIN=http://localhost:3000,http://localhost:5173,https://localhost,capacitor://localhost
DATABASE_URL=postgres://user:password@localhost:5432/xocrisk
AUTH_SESSION_SECRET=replace_with_at_least_32_random_bytes

# Optional sign-in providers. Set each provider's three values together.
# Register these exact callback URLs in the provider developer consoles.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_REDIRECT_URI=
MICROSOFT_TENANT_ID=common

# Required to enable email password recovery; use an SMTP account dedicated to XOCRISK.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
